#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { flavor = "tap-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <26 27>;
        };

        combo_ent {
            bindings = <&kp ENTER>;
            key-positions = <32 33>;
        };

        to_l1 {
            bindings = <&to 0>;
            key-positions = <29 30>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        hs: homerow_shifts {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFTS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "qwert";
            bindings = <
&none        &kp Q             &kp W  &kp E           &kp R           &kp T        &kp Y          &kp U           &kp I           &kp O    &kp P                  &caps_word
&key_repeat  &kp A             &kp S  &hm LEFT_ALT D  &hm LEFT_WIN F  &kp G        &kp H          &hm LEFT_WIN J  &hm LEFT_ALT K  &kp L    &kp UNDER              &key_repeat
&to 4        &hs LEFT_SHIFT Z  &kp X  &kp C           &kp V           &kp B        &kp N          &kp M           &kp COMMA       &kp DOT  &hs RIGHT_SHIFT SLASH  &none
                                      &to 2           &lt 3 SPACE     &sk LCTRL    &kp BACKSPACE  &kp ENTER       &kp TAB
            >;

            label = "base";
        };

        symbol_layer {
            bindings = <
&none  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE         &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp NON_US_BACKSLASH  &none
&none  &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND    &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES     &none
&none  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT      &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SQT               &none
                                       &none             &none              &none            &none        &none                 &none
            >;

            label = "symbol";
        };

        number_layer {
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8      &kp N9  &kp N0        &none
&none  &none   &none   &none   &none   &none     &none   &kp N4  &kp N5      &kp N6  &kp KP_PLUS   &kp KP_MULTIPLY
&none  &none   &none   &none   &none   &none     &none   &kp N1  &kp N2      &kp N3  &kp KP_MINUS  &kp KP_DIVIDE
                       &to 0   &none   &none     &none   &kp N0  &kp KP_DOT
            >;

            label = "number";
        };

        navigation_layer {
            bindings = <
&none  &none     &none     &none      &none      &none    &none     &none          &none      &none      &none               &none
&none  &sk LGUI  &sk LALT  &sk LSHFT  &sk LCTRL  &none    &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &kp K_CONTEXT_MENU  &none
&none  &none     &none     &none      &none      &none    &kp HOME  &kp PAGE_DOWN  &kp PG_UP  &kp END    &none               &none
                           &none      &none      &none    &none     &none          &none
            >;

            label = "nav";
        };

        fucntion_layer {
            bindings = <
&kp F1  &kp F2        &kp F3          &kp F4      &kp F5            &kp F6             &kp F7      &kp F8           &kp F9        &kp F10               &kp F11               &kp F12
&none   &sk LEFT_WIN  &sk LALT        &sk LSHFT   &sk LCTRL         &kp PRINTSCREEN    &none       &none            &none         &none                 &none                 &none
&none   &kp CLCK      &kp C_PREVIOUS  &kp C_NEXT  &kp C_PLAY_PAUSE  &none              &kp K_MUTE  &kp C_VOLUME_UP  &kp C_VOL_DN  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &none
                                      &to 0       &bootloader       &bt BT_PRV         &bt BT_NXT  &bootloader      &bt BT_CLR
            >;

            label = "func";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
